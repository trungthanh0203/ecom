# Sao chép thành tests/.env.test (đã nằm trong .gitignore) rồi điền tài khoản THỬ NGHIỆM. Không gửi file này cho ai.
# Mỗi dòng là 1 vai trò; vai trò nào để trống sẽ bị bỏ qua. Nên dùng email/mật khẩu dùng-một-lần cho kiểm thử.
SA_EMAIL=
SA_PASS=
ADMIN_EMAIL=
ADMIN_PASS=
EDITOR_EMAIL=
EDITOR_PASS=
CONTRIBUTOR_EMAIL=
CONTRIBUTOR_PASS=
SALES_EMAIL=
SALES_PASS=
ORDER_EMAIL=
ORDER_PASS=
# Cho npm run test:live-admin (quản lý nhân sự):
WORKER_URL=
# Tuỳ chọn: để script tự dọn tài khoản thử (nếu trống, script chỉ khoá và in câu SQL xoá)
SERVICE_ROLE_KEY=
